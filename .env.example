# Copy to .env.local and fill in. .env.local is gitignored.
# Telegram bot token from @BotFather (only needed for the bot).
TELEGRAM_BOT_TOKEN=
# Random secret so only Telegram can post to /api/telegram/webhook (the always-on bot on Vercel).
# Any 20-60 letters, digits, - or _. Set the same value in Vercel. See README → Telegram bot.
TELEGRAM_WEBHOOK_SECRET=
# Admin key for Settings → Access log (visitors' IP addresses and locations). Required on Vercel.
# Any long random string; enter it once in the Settings page. See README → Access log.
ADMIN_KEY=
# Where the access log is stored on Vercel: added automatically by Vercel → Storage → Upstash for Redis.
# (Leave empty locally: a local server keeps data/access-log.json.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Automatic directory sync every 6 hours (12 AM, 6 AM, 12 PM, 6 PM in this zone). KAPILYA_AUTO_SYNC=off disables it.
SYNC_TIMEZONE=Asia/Manila
# Optional: Google Distance Matrix key so distances match Google Maps exactly (default: OSRM).
GOOGLE_MAPS_API_KEY=
